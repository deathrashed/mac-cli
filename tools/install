#!/bin/sh

# Colors
GREEN='\033[0;32m'
LIGHTGREEN='\033[1;32m'
LIGHTBLUE='\033[01;34m'
NC='\033[0m' # No Color

# Check for existing mac-cli installation
MAC_CLI_DIR=""
if [ -L "$HOME/.mac-cli" ]; then
    # ~/.mac-cli exists as a symlink - use the target
    MAC_CLI_DIR="$HOME/.mac-cli"
    echo "${LIGHTGREEN}Found existing mac-cli at ~/.mac-cli (symlinked)${NC}"
elif [ -d "$HOME/.mac-cli" ]; then
    # ~/.mac-cli exists as a directory
    MAC_CLI_DIR="$HOME/.mac-cli"
    echo "${LIGHTGREEN}Found existing mac-cli at ~/.mac-cli${NC}"
else
    # No existing installation - need to clone
    MAC_CLI_DIR="$HOME/.mac-cli"
fi

# In directory (for when running from repo)
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

suggest_current(){
    case "$1" in
        "editor")
            current=$EDITOR
        ;;
        *)
            current=$(which $1)
        ;;
    esac
    if [ -n $current ]; then
        echo $current | pbcopy
        echo "${NC}Press ⌘V to insert current (${current})"
    fi
}

main() {

    echo "${LIGHTBLUE}================================================"
    echo " Mac CLI Installer"
    echo "================================================${NC}\n"

    # If no existing installation, clone the repo
    if [ ! -d "$MAC_CLI_DIR" ] && [ ! -L "$MAC_CLI_DIR" ]; then
        echo "Cloning mac-cli to ~/.mac-cli..."
        git clone https://github.com/guarinogabriel/mac-cli.git --depth 1 "$MAC_CLI_DIR"
    fi

    printf "${LIGHTGREEN}"
    read -r -p "Would you like Mac CLI to show you the commands that are run on each mac command? (Yes / No)" response
    case $response in
        [yY][eE][sS]|[yY])
            LC_CTYPE=C sed -i'' -e 's#echocommand="false"#echocommand="true"#g' "$MAC_CLI_DIR/mac"
            ;;
        *)
            ;;
    esac
    printf "${NC}"

    # Create symlink for mac command
    sudo ln -sf "$MAC_CLI_DIR/mac" /usr/local/bin/mac
    sudo chmod -R +x "$MAC_CLI_DIR"/*

    if ! [ -x "$(command -v brew)" ]; then
        echo "Installing Homebrew..."
        echo "${GREEN}/usr/bin/ruby -e '\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)'\n${NC}"
        /usr/bin/ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"
    fi

    if ! [ -x "$(command -v git)" ]; then
        echo "Installing Git..."
        echo "${GREEN}brew install git\n${NC}"
        brew install git
	  fi

    if ! [ -x "$(command -v pv)" ]; then
        echo "Installing pv (Pipe Viewer)..."
        echo "${GREEN}brew install pv\n${NC}"
        brew install pv
	  fi

    if ! [ -x "$(command -v wget)" ]; then
        echo "Installing wget..."
        printf "${GREEN}brew install wget\n${NC}"
        brew install wget
	  fi

    if ! brew list | grep -q bash-completion ; then

            echo "Installing bash-completion\n"
            echo "${GREEN}brew install bash-completion\n\n${NC}"
            brew install bash-completion
            echo 'if [ -f $(brew --prefix)/etc/bash_completion ]; then source $(brew --prefix)/etc/bash_completion; fi' >> ~/.bashrc
            echo "Setting up Mac-CLI bash-completion\n"

        if [ -d /usr/local/etc/bash_completion.d/ ]; then
            ln -sf "$MAC_CLI_DIR/completion/bash_completion" /usr/local/etc/bash_completion.d/mac
        fi

    else

        echo "Setting up Mac-CLI bash-completion\n"

        if [ -d $(brew --prefix)/etc/bash_completion.d/ ]; then
            ln -sf "$MAC_CLI_DIR/completion/bash_completion" $(brew --prefix)/etc/bash_completion.d/mac
            echo 'if [ -f $(brew --prefix)/etc/bash_completion ]; then source $(brew --prefix)/etc/bash_completion; fi' >> ~/.bashrc
        fi

    fi

    # Install Zsh completion
    echo "Setting up Mac-CLI Zsh completion\n"
    mkdir -p "$MAC_CLI_DIR/completion/zsh"

    #
    # Check if fish shell is installed and prompt user to copy fish_completion
    #
    if $(cat /etc/shells | grep -q fish) && [ -d ~/.config/fish ];
    then
	    printf "${LIGHTGREEN}"
	    read -r -p "Would you like to install fish shell suggestions/tab completion? (Yes / No) " response
	    case $response in
		    [yY][eE][sS]|[yY])
			    echo "Setting up Mac-CLI Fish completion"
			    if [ -d ~/.config/fish/completions ];then
				    ln -sf "$MAC_CLI_DIR/completion/fish_completion" ~/.config/fish/completions/mac.fish
			    else
				    mkdir ~/.config/fish/completions && ln -sf "$MAC_CLI_DIR/completion/fish_completion" ~/.config/fish/completions/mac.fish
			    fi
			    ;;
		    *)
			    ;;
	    esac
	    printf "${NC}"
    fi

    # Add PATH and fpath setup for Zsh
    if [ -f ~/.zshrc ]; then
        echo "Adding PATH and fpath setup to ~/.zshrc"
        # Remove existing mac-cli block if it exists
        sed -i '' '/# >>> mac-cli >>>/,/# <<< mac-cli <<</d' ~/.zshrc
        # Add idempotent block
        cat >> ~/.zshrc << EOF
# >>> mac-cli >>>
export MAC="$MAC_CLI_DIR"
export PATH="$MAC_CLI_DIR:\$PATH"
fpath=("$MAC_CLI_DIR/completion/zsh" \$fpath)
autoload -Uz compinit
compinit -i
# <<< mac-cli <<<
EOF
    fi
}

main
