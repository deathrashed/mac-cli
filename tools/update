#!/bin/sh

GREEN='\033[0;32m'
NC='\033[0m' # No Color

MAC_CLI_DIR="$HOME/.mac-cli"

main() {
  echo "Upgrading Mac CLI..."

  # Check if using symlinked setup
  if [ -L "$MAC_CLI_DIR" ]; then
    echo "Found symlinked mac-cli at ~/.mac-cli"
    echo "Pulling latest changes from git..."
    cd "$MAC_CLI_DIR"
    git pull
    # Re-create the symlink
    sudo ln -sf "$MAC_CLI_DIR/mac" /usr/local/bin/mac
    echo "${GREEN}Mac CLI has been updated to the latest version\n${NC}"
  elif [ -d "$MAC_CLI_DIR" ]; then
    # Standard directory installation
    sudo rm /usr/local/bin/mac 2>/dev/null || true
    sudo rm -rf /usr/local/bin/mac-cli 2>/dev/null || true
    if [ -d ~/Downloads/mac-cli-update/ ]; then
        rm -rf ~/Downloads/mac-cli-update/
    fi
    mkdir ~/Downloads/mac-cli-update/ && cd ~/Downloads/mac-cli-update/
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/deathrashed/mac-cli/master/mac-cli/tools/install)" && cd -
    echo "${GREEN}Mac CLI has been updated to the latest version\n${NC}"
  else
    echo "No existing mac-cli installation found. Running fresh install..."
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/deathrashed/mac-cli/master/mac-cli/tools/install)"
  fi
}

main
