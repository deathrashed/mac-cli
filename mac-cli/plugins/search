#!/bin/sh

#--------------------------------------------------------------------
# Search Utilities
#--------------------------------------------------------------------

# Search operations plugin for mac-cli
# This plugin provides tools for searching files, directories, and content

case "$fn" in

    # Search for files by name using fd or find
    "search:file")
        # Specify the pattern to search for files
        local pattern="$firstParameter"
        if [ -z "$pattern" ]; then
            echo "Please specify a pattern to search for."
            echo "E.g.: mac search:file *.txt"
            exit 1
        fi
        echo "Searching for files matching '$pattern'..."
        if command -v fd &> /dev/null; then
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}fd '$pattern'\n${NC}"
            fi
            fd "$pattern"
        else
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}find . -type f -name '$pattern'\n${NC}"
            fi
            find . -type f -name "$pattern"
        fi
    ;;

    # Search for directories by name using fd or find
    "search:dir")
        # Specify the pattern to search for directories
        local pattern="$firstParameter"
        if [ -z "$pattern" ]; then
            echo "Please specify a pattern to search for."
            echo "E.g.: mac search:dir logs"
            exit 1
        fi
        echo "Searching for directories matching '$pattern'..."
        if command -v fd &> /dev/null; then
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}fd '$pattern' --type d\n${NC}"
            fi
            fd "$pattern" --type d
        else
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}find . -type d -name '$pattern'\n${NC}"
            fi
            find . -type d -name "$pattern"
        fi
    ;;

    # Search file contents for a pattern using rg or grep
    "search:content")
        # Specify the pattern to search within file contents
        local pattern="$firstParameter"
        if [ -z "$pattern" ]; then
            echo "Please specify a pattern to search for in file contents."
            echo "E.g.: mac search:content error"
            exit 1
        fi
        echo "Searching for content matching '$pattern'..."
        if command -v rg &> /dev/null; then
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}rg '$pattern'\n${NC}"
            fi
            rg "$pattern"
        else
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}grep -r '$pattern' .\n${NC}"
            fi
            grep -r "$pattern" .
        fi
    ;;

    # Search for recently modified files using mdfind or find
    "search:recent")
        # Specify the time frame or use default (last 24 hours)
        local timeframe="${firstParameter:-1d}"
        echo "Searching for files modified in the last $timeframe..."
        if command -v mdfind &> /dev/null; then
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}mdfind 'kMDItemFSContentChangeDate > \$time.today(-1)'\n${NC}"
            fi
            mdfind "kMDItemFSContentChangeDate > \$time.today(-1)"
        else
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}find . -type f -mtime -$timeframe\n${NC}"
            fi
            find . -type f -mtime -"$timeframe"
        fi
    ;;

    # Search using Spotlight for quick results
    "search:spotlight")
        # Specify the query to search with Spotlight
        local query="$firstParameter"
        if [ -z "$query" ]; then
            echo "Please specify a query to search with Spotlight."
            echo "E.g.: mac search:spotlight document"
            exit 1
        fi
        echo "Searching with Spotlight for '$query'..."
        if [ "$echocommand" == "true" ]; then
            echo "${GREEN}mdfind '$query'\n${NC}"
        fi
        mdfind "$query"
    ;;

    # Search for text in Dash documentation
    "search:dash")
        # Specify the query to search in Dash
        local query="$firstParameter"
        if [ -z "$query" ]; then
            echo "Please specify a query to search in Dash."
            echo "E.g.: mac search:dash python list"
            exit 1
        fi
        echo "Searching Dash for '$query'..."
        if [ "$echocommand" == "true" ]; then
            echo "${GREEN}open dash://'$query'\n${NC}"
        fi
        open "dash://$query"
    ;;

    # Search for text in DevDocs online documentation
    "search:devdocs")
        # Specify the query to search in DevDocs
        local query="$firstParameter"
        if [ -z "$query" ]; then
            echo "Please specify a query to search in DevDocs."
            echo "E.g.: mac search:devdocs javascript array"
            exit 1
        fi
        echo "Searching DevDocs for '$query'..."
        if [ "$echocommand" == "true" ]; then
            echo "${GREEN}open 'https://devdocs.io/#q=$query'\n${NC}"
        fi
        open "https://devdocs.io/#q=$query"
    ;;

    # Find files modified in the last N minutes
    "find:recent")

        if [ ! -z "$firstParameter" -a "$firstParameter" != " " ]; then
            echo "Searching for files modified in the last $firstParameter minutes..."
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}find . -mmin ${GRAY}$firstParameter${GREEN} -type f\n\n${NC}"
            fi
            find . -mmin "$firstParameter" -type f
        else
            echo "Please specify the number of minutes to search back."
            echo "E.g.: mac find:recent 60"
        fi
    ;;

    "search:content")
        local pattern="$firstParameter"
        local dir="${secondParameter:-.}"
        if [ -z "$pattern" ]; then
            echo "Please specify a pattern to search for in content."
            echo "E.g.: mac search:content 'blast beat' ~/Notes"
            exit 1
        fi
        echo "Searching for content matching '$pattern' in $dir..."
        if command -v rg &> /dev/null; then
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}rg \"$pattern\" \"$dir\"\n${NC}"
            fi
            rg "$pattern" "$dir"
        else
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}grep -r \"$pattern\" \"$dir\"\n${NC}"
            fi
            grep -r "$pattern" "$dir" 2>/dev/null
        fi
    ;;

    "search:recent")
        local minutes="$firstParameter"
        if [ -z "$minutes" ]; then
            echo "Please specify the number of minutes to search back for recently modified files."
            echo "E.g.: mac search:recent 60"
            exit 1
        fi
        echo "Searching for files modified in the last $minutes minutes..."
        if command -v mdfind &> /dev/null; then
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}mdfind -onlyin . \"kMDItemFSContentChangeDate > \$time.now(-$minutes*60)\"\n${NC}"
            fi
            mdfind -onlyin . "kMDItemFSContentChangeDate > \$time.now(-$minutes*60)"
        else
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}find . -mmin -$minutes -type f\n${NC}"
            fi
            find . -mmin -$minutes -type f
        fi
    ;;

esac
