#!/bin/sh

#--------------------------------------------------------------------
# URL Utilities
#--------------------------------------------------------------------

# URL utilities plugin for mac-cli
# This plugin provides tools for creating URL shortcuts on the desktop

case "$fn" in

    # Create a URL shortcut on the desktop
    "url:create")
        # Specify the URL and optional title for the shortcut
        local url="$firstParameter"
        local title="${secondParameter:-}"
        if [ -z "$url" ]; then
            echo "Please specify a URL to create a shortcut for."
            echo "E.g.: mac url:create https://example.com 'Example'"
            exit 1
        fi
        local shortcut_file="$(basename "$url" | tr -d '[:punct:]').webloc"
        if [ -n "$title" ]; then
            shortcut_file="$(echo "$title" | tr -d '[:punct:]').webloc"
        fi
        echo "Creating URL shortcut for $url on desktop..."
        if [ "$echocommand" == "true" ]; then
            echo "${GREEN}osascript -e 'tell application \"Finder\" to make new internet location file at desktop to \"$url\"'\n${NC}"
        fi
        osascript -e "tell application \"Finder\" to make new internet location file at desktop to \"$url\"" >/dev/null
        echo "Shortcut created on desktop."
    ;;

    # Create a URL shortcut on the desktop, overwriting if it exists
    "url:create-force")
        # Specify the URL and optional title for the shortcut, force overwrite if exists
        local url="$firstParameter"
        if [ -z "$url" ]; then
            echo "Please specify a URL to create a shortcut for."
            echo "E.g.: mac url:create-force https://example.com"
            exit 1
        fi
        echo "Creating URL shortcut for $url on desktop (force overwrite)..."
        # Check if a shortcut already exists and delete it
        local shortcut_name=$(basename "$url")
        local shortcut_path="~/Desktop/$shortcut_name.webloc"
        if [ -f "$shortcut_path" ]; then
            if [ "$echocommand" == "true" ]; then
                echo "${GREEN}rm -f $shortcut_path\n${NC}"
            fi
            rm -f "$shortcut_path"
            echo "Existing shortcut removed."
        fi
        if [ "$echocommand" == "true" ]; then
            echo "${GREEN}osascript -e 'tell application \"Finder\" to make new internet location file at desktop to \"$url\"'\n${NC}"
        fi
        osascript -e "tell application \"Finder\" to make new internet location file at desktop to \"$url\"" >/dev/null
        echo "Shortcut created on desktop."
    ;;

esac
