#--------------------------------------------------------------------
# Catch command not found
#--------------------------------------------------------------------

if [[ ! " ${COMMANDS[@]} " =~ " ${fn} " ]]; then
    echo "${RED}Command not found: '${fn}'${NC}"
    if [ -n "$allParameters" ] && [ "$allParameters" != " " ]; then
        echo "${YELLOW}Parameters: $allParameters${NC}"
    fi

    if command -v fzf &>/dev/null; then
        category=$(printf "%s\n" "${MacCategories[@]}" | fzf \
            --prompt="Category > " \
            --height=~50% \
            --layout=reverse \
            --border=rounded \
            --info=hidden \
            --header="Select a category to see its commands" \
            --color="header:italic:blue,prompt:blue,pointer:green,hl:green,hl+:green")
    else
        echo "${LIGHTBLUE}Available categories:${NC}"
        printf "${GREEN}"
        printf "    %s\n" "${MacCategories[@]}" | column
        printf "${NC}\n"
        printf "${LIGHTBLUE}Choose a category: ${NC}"
        read -r category
    fi

    if [ -n "${category}" ]; then
        echo "$(usageList ${category})\n"
        echo "$(printAdditionalHelp)"
    else
        kill -INT $$
    fi
fi

