# Define the base directory for mac-cli. Prefer the script location so symlinked
# installs and local checkouts run the same code, while still allowing tests and
# the Go compatibility runner to override it.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    SOURCE_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
    TARGET="$(readlink "$SOURCE")"
    case "$TARGET" in
        /*) SOURCE="$TARGET" ;;
        *) SOURCE="${SOURCE_DIR}/${TARGET}" ;;
    esac
done
SCRIPT_DIR="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
MAC_CLI_BASE_DIR="${MAC_CLI_BASE_DIR:-${SCRIPT_DIR}}"

run_tui() {
    if [ -x "${MAC_CLI_BASE_DIR}/bin/mac-tui" ]; then
        exec "${MAC_CLI_BASE_DIR}/bin/mac-tui" --tui
    fi

    if command -v go >/dev/null 2>&1 && [ -f "${MAC_CLI_BASE_DIR}/go.mod" ]; then
        cd "${MAC_CLI_BASE_DIR}" || exit 1
        exec go run ./cmd/mac --tui
    fi

    echo "Mac CLI TUI is not built and Go is not available."
    echo "Build it with: cd ${MAC_CLI_BASE_DIR} && go build -o bin/mac-tui ./cmd/mac"
    exit 1
}

case "${1:-}" in
    ""|"--tui"|"tui")
        run_tui
    ;;
esac

